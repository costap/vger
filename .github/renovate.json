{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits"
  ],
  "schedule": ["before 6am on monday"],
  "timezone": "UTC",
  "labels": ["dependencies"],
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "postUpdateOptions": [
    "gomodTidy",
    "gomodUpdateImportPaths"
  ],
  "packageRules": [
    {
      "description": "Group Google GenAI, Genkit, and Cloud SDKs",
      "matchPackagePrefixes": [
        "google.golang.org/",
        "cloud.google.com/",
        "github.com/firebase/genkit/go"
      ],
      "groupName": "google and genai sdk dependencies"
    },
    {
      "description": "Group all GitHub Actions updates",
      "matchManagers": ["github-actions"],
      "groupName": "github actions dependencies"
    },
    {
      "description": "Separate major updates and do not group them",
      "matchUpdateTypes": ["major"],
      "groupName": null,
      "labels": ["dependencies", "major-update"]
    }
  ]
}
